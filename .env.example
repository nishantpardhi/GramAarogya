# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Database Connection
# Connects the Node.js / Express / Mongoose backend to your MongoDB Atlas cluster or local database.
# If omitted, the server automatically uses a zero-config in-memory live data layer.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/gramarogya?retryWrites=true&w=majority"

# JWT Secret for User Authentication & RBAC token generation
JWT_SECRET="gramarogya_secure_node_jwt_secret_key_2025"

# Cloudinary Storage Configuration (Optional for profile avatars & medical report image storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
